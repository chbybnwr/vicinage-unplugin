{
  "extends": [
    "@txe/tsconfig/tsconfig.base.json",
    "@txe/tsconfig/tsconfig.node24.json",
    "@txe/tsconfig/tsconfig.library.json",
    "@txe/tsconfig/tsconfig.bundled.json"
  ],
  "include": ["src"],
  "exclude": ["src/**/*.spec*.*", "src/test/**/*"],

  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",

    "rootDir": "./src/",
    "outDir": "./dist/",

    "skipLibCheck": true,

    "paths": {
      "#/*": ["./src/*"]
    }
  }
}
